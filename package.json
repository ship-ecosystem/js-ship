{
  "name": "@ship-ecosystem/js",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Cross-platform Docker development environments and portable releases for JavaScript applications.",
  "repository": { "type": "git", "url": "git+https://github.com/ship-ecosystem/js-ship.git" },
  "bugs": { "url": "https://github.com/ship-ecosystem/js-ship/issues" },
  "homepage": "https://github.com/ship-ecosystem/js-ship#readme",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ship": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "docs",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:docker": "npm run build && node --test --test-concurrency=2 test/docker/*.test.mjs",
    "test:browser": "npm run build && node --test test/browser/*.test.mjs",
    "test:transfer": "npm run build && node scripts/check-release-transfer.mjs local",
    "test:package": "npm run build && node scripts/check-package.mjs",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright": "1.65.1",
    "typescript": "5.9.3"
  }
}
