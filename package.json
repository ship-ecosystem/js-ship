{
  "name": "@shipecosystem/js-ship",
  "version": "0.1.1",
  "private": false,
  "description": "Cross-platform Docker development environments and portable releases for JavaScript applications.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ship-ecosystem/js-ship.git"
  },
  "bugs": {
    "url": "https://github.com/ship-ecosystem/js-ship/issues"
  },
  "homepage": "https://github.com/ship-ecosystem/js-ship#readme",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || ^26.13.1"
  },
  "bin": {
    "ship": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema.json": "./schema/canonical/ship.schema.json"
  },
  "files": [
    "dist",
    "templates",
    "schema",
    "docs",
    "README.md",
    "LICENSE.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "node scripts/write-images.mjs && tsc -p tsconfig.json && node scripts/write-schema.mjs",
    "typecheck": "node scripts/write-images.mjs && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:docker": "npm run build && node --test --test-concurrency=2 test/docker/*.test.mjs",
    "test:browser": "npm run build && node --test --test-concurrency=1 test/browser/*.test.mjs",
    "test:transfer": "npm run build && node scripts/check-release-transfer.mjs local",
    "test:package": "npm run build && node scripts/check-package.mjs",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run build",
    "release:check": "node scripts/check-npm-release.mjs",
    "check:spec": "node scripts/check-spec.mjs",
    "check:release": "node scripts/spec/check-release.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "playwright": "1.65.1",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  },
  "dependencies": {
    "@clack/prompts": "1.9.0"
  }
}
